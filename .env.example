POSTGRES_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
AI_RATE_LIMIT=120
AI_DAILY_LIMIT=1000
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Optional: hosted Postgres such as Supabase (session pooler). When set, the API uses it instead of the db service.
# DATABASE_URL=postgresql+psycopg://atelier_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Milliseconds the web server waits for the API when rendering pages (default 10000).
# API_TIMEOUT_MS=10000
